---
import BaseLayout from '../../layouts/BaseLayout.astro';import {apiFetch,type ApiResult,type TopicDetail,parseComponents} from '../../lib/api';import {deltaLabel,lifecycleLabel,momentumLabel} from '../../lib/format';
const slug=Astro.params.slug??'';const response=await apiFetch<ApiResult<TopicDetail>>(Astro.locals,`/api/v1/topics/${encodeURIComponent(slug)}?days=30`);if(!response?.data){Astro.response.status=404;}
const topic=response?.data;const title=topic?.canonical_title_zh||topic?.canonical_title_en||'Topic 不存在';const components=parseComponents(topic?.components_json);
const history=(topic?.history??[]) as Array<any>;const byRegion=(region:string)=>history.filter((p)=>p.region===region);const sources=(topic?.sources??[]) as Array<any>;
---
<BaseLayout title={`${title} — Hot Topics`} description={topic?`${title} 的互联网注意力热度、变化、平台来源与历史快照。`:'Topic 不存在'} noindex={!topic}>
{topic?<><section class="topic-hero"><div><span class="eyebrow">{topic.category}</span><h1>{title}</h1>{topic.canonical_title_en&&topic.canonical_title_en!==title&&<p lang="en">{topic.canonical_title_en}</p>}</div><div class="hero-metrics"><div><span>Heat</span><strong>{Math.round(Number(topic.heat??Math.max(topic.china_heat,topic.global_heat)))}</strong></div><div><span>3H Delta</span><strong>{deltaLabel(topic.delta,Boolean(topic.is_new))}</strong></div><div><span>生命周期</span><strong>{lifecycleLabel(topic.lifecycle)}</strong></div></div></section>
<section class="detail-grid"><div><h2>注意力解释</h2><dl class="metrics-list"><div><dt>中国 Heat</dt><dd>{Math.round(Number(topic.china_heat))}</dd></div><div><dt>Global Heat</dt><dd>{Math.round(Number(topic.global_heat))}</dd></div><div><dt>Momentum</dt><dd>{momentumLabel(topic.momentum)}</dd></div><div><dt>跨平台指数</dt><dd>{Math.round(Number(topic.cross_platform_index))}</dd></div><div><dt>Evidence Coverage</dt><dd>{Math.round(Number(topic.evidence_coverage))}</dd></div><div><dt>Coverage Confidence</dt><dd>{Math.round(Number(topic.coverage_confidence))}%</dd></div></dl></div>
<div><h2>Heat 构成</h2><dl class="metrics-list">{Object.entries(components).map(([k,v])=><div><dt>{k}</dt><dd>{Math.round(Number(v))}</dd></div>)}</dl></div></section>
<section><h2>历史快照</h2><div class="history-summary"><div><strong>CN</strong><span>{byRegion('CN').length} snapshots</span></div><div><strong>GLOBAL</strong><span>{byRegion('GLOBAL').length} snapshots</span></div></div>{history.length<2&&<p class="muted">历史尚不足，3D / 7D / 30D 曲线暂不生成，避免伪造趋势。</p>}</section>
<section><h2>原始来源</h2><div class="source-list">{sources.map((s)=><a href={s.url||'#'} target="_blank" rel="noopener noreferrer"><span><strong>{s.source_name}</strong> · {s.title}</span><em>{s.rank?`#${s.rank}`:''}</em></a>)}</div></section></>:<section class="page-head"><h1>Topic 不存在</h1><p>它可能尚未形成生产快照，或 URL 已失效。</p></section>}
</BaseLayout>
